# Copy to backend/.env  (never commit it)
PORT=4000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=Industrial_IoT
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=industrial_iot
# 32+ characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
INGEST_API_KEY=device-key-change-me
# set to true only when served over HTTPS
COOKIE_SECURE=false
