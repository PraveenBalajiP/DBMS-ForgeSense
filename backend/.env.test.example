# Copy to backend/.env.test. Tests refuse to run unless MYSQL_DATABASE ends with _test
PORT=4100
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=Industrial_IoT_test
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=industrial_iot_test
JWT_SECRET=test-only-secret-test-only-secret-1234567890
INGEST_API_KEY=test-ingest-key
COOKIE_SECURE=false
BASE_URL=http://localhost:4100
