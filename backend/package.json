{
  "name": "iiot-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express REST API: MySQL (operational data) + MongoDB (telemetry) + regression forecasting",
  "engines": { "node": ">=20.6" },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "start:test": "node --env-file=.env.test src/server.js",
    "db:setup": "node --env-file=.env scripts/reset-db.js setup",
    "db:reset": "node --env-file=.env scripts/reset-db.js reset",
    "db:setup:test": "node --env-file=.env.test scripts/reset-db.js setup",
    "db:reset:test": "node --env-file=.env.test scripts/reset-db.js reset",
    "doctor": "node --env-file=.env scripts/doctor.js",
    "doctor:test": "node --env-file=.env.test scripts/doctor.js",
    "seed:mongo": "node --env-file=.env scripts/seed-mongo.js",
    "load:sample": "node --env-file=.env scripts/load-sample.js",
    "simulate": "node --env-file=.env scripts/simulate.js",
    "test:unit": "node --test tests/unit/regression.test.js tests/unit/routes.test.js",
    "test:db": "node --env-file=.env.test --test tests/db/integrity.test.js",
    "test:api": "node --env-file=.env.test --test tests/api/api.test.js",
    "test:telemetry": "node --env-file=.env.test --test tests/integration/telemetry.test.js",
    "test:all": "npm run test:unit && npm run test:db && npm run test:api && npm run test:telemetry"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "mongodb": "^6.12.0",
    "mysql2": "^3.12.0"
  }
}
